#! /bin/bash

set -euo pipefail

name=""
prefix=""
layout=even-horizontal
newline=1

while [[ "$1" =~ ^- ]]; do
	case "$1" in
		--) shift; break;;
		-n) name="$2"; shift 2;;
		-p) prefix="$2"; shift 2;;
		-v) layout=even-vertical; shift;;
		-t) layout=tiled; shift;;
		-x) newline=0; shift;;
		*)
			echo "unrecognised argument $1"
			exit 1
			;;
	esac
done

gencmd() {
	echo " printf '\\033]2;$1\\033\\\\'"$'\n'"$1"
	# '" # fix highlighting
}

if [[ "$name" == "" ]]; then
	name="$prefix$(head -c4 /dev/urandom | xxd -ps)"
fi

maybe_newline=""
if (( newline )); then
	maybe_newline=C-m
fi

args=(
	new-session -n "$name" -s "$name" \;
	send-keys "$(gencmd "$1")" $maybe_newline \;
	select-layout "$layout" \;
)
shift 1
for cmd in "$@"; do
	args+=(
		new-window -n "$cmd" \;
		send-keys "$(gencmd "$cmd")" $maybe_newline \;
		join-pane -t "$name" \;
		select-layout "$layout" \;
	)
done
args+=(
	setw synchronize-panes on \;
)

exec tmux "${args[@]}"
